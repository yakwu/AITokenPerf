# Docker 部署必需变量
DB_PASSWORD=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-random-string

# CORS 允许的跨域来源（逗号分隔，留空 = 允许所有）
CORS_ORIGINS=http://localhost

# Run Center 并发准入控制（slot = 一个正在执行的上游请求/长连接）
RUN_MAX_USER_SLOTS=5000
RUN_MAX_GLOBAL_SLOTS=20000
RUN_MAX_CHILDREN_PER_RUN=10

# 仅单租户部署建议开启。开启后 API_KEY/BASE_URL/MODEL 可覆盖用户 Profile。
ALLOW_PROFILE_ENV_OVERRIDES=0
